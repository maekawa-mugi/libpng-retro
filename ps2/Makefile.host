# Standalone host regression tests.  This does not run any R5900 assembly.
CC ?= cc
CFLAGS ?= -O2 -std=c99 -Wall -Wextra -Werror
PYTHON ?= python3

.PHONY: all test clean
all: test

ps2/test_ab_summary_host: ps2/test_ab_summary_host.c ps2/bench_ab_summary.h
	$(CC) $(CFLAGS) ps2/test_ab_summary_host.c -o $@

test: ps2/test_ab_summary_host

ps2/test_fused_host: ps2/test_fused_host.c ps2/bench_filter_mmi.c ps2/bench_ab_summary.h ps2/extra_kernels_mmi.c ps2/extra_full_kernels.c ps2/extra_color_kernels.c ps2/filter_rgb3.c ps2/filter_wide_mmi.c
	$(CC) $(CFLAGS) -Wno-unused-function ps2/test_fused_host.c -o $@

test: ps2/test_fused_host

ps2/test_rgb3_host: ps2/test_rgb3_host.c ps2/filter_rgb3.c
	$(CC) $(CFLAGS) ps2/test_rgb3_host.c -o $@

ps2/test_rgb3_prefix_host: ps2/test_rgb3_host.c ps2/filter_rgb3.c ps2/filter_sub3_prefix_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_SUB3_PREFIX ps2/test_rgb3_host.c -o $@

ps2/test_gray_prefix_host: ps2/test_gray_host.c ps2/filter_gray_mmi.c ps2/filter_gray_prefix_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_GRAY_PREFIX16 ps2/test_gray_host.c -o $@

ps2/test_up_2x_host: ps2/test_up_host.c ps2/filter_up_unrolled_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_UP_2X_HOST_TEST ps2/test_up_host.c -o $@

ps2/test_up_schedules_host: ps2/test_up_schedules_host.c ps2/filter_up_schedules_mmi.c ps2/filter_up4_mmi.c
	$(CC) $(CFLAGS) ps2/test_up_schedules_host.c -o $@

ps2/test_up_host: ps2/test_up_host.c ps2/filter_up_mmi.c
	$(CC) $(CFLAGS) ps2/test_up_host.c -o $@

ps2/test_wide_host: ps2/test_wide_host.c ps2/filter_wide_mmi.c
	$(CC) $(CFLAGS) ps2/test_wide_host.c -o $@

ps2/test_wide_words_host: ps2/test_wide_host.c ps2/filter_wide_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_SUB8_WORDS ps2/test_wide_host.c -o $@

ps2/test_wide_prefix_host: ps2/test_wide_host.c ps2/filter_wide_mmi.c ps2/filter_sub8_prefix_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_SUB8_PREFIX16 ps2/test_wide_host.c -o $@

ps2/test_gray_host: ps2/test_gray_host.c ps2/filter_gray_mmi.c
	$(CC) $(CFLAGS) ps2/test_gray_host.c -o $@

ps2/test_paeth_mask_host: ps2/test_paeth_host.c ps2/filter_paeth_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_PAETH_MASK ps2/test_paeth_host.c -o $@

ps2/test_compact_layout_host: ps2/test_compact_layout_host.c ps2/compact_layout.h
	$(CC) $(CFLAGS) ps2/test_compact_layout_host.c -o $@

test: ps2/test_compact_layout_host

ps2/test_palette_hook_host: ps2/test_palette_hook_host.c ps2/palette_production.c ps2/test_palette_hook.c
	$(CC) $(CFLAGS) ps2/test_palette_hook_host.c -o $@

test: ps2/test_palette_hook_host

ps2/test_extra_host: ps2/test_extra_host.c ps2/test_extra_kernels.c ps2/extra_kernels_mmi.c ps2/extra_full_kernels.c ps2/test_full_kernels.c ps2/extra_color_kernels.c ps2/test_color_kernels.c
	$(CC) $(CFLAGS) ps2/test_extra_host.c -o $@

ps2/test_full_syntax_host: ps2/test_full_syntax.c ps2/extra_kernels_mmi.c ps2/extra_full_kernels.c ps2/extra_color_kernels.c
	$(CC) $(CFLAGS) -Wno-unused-function -DPNG_PS2_EXTRA_PORTABLE ps2/test_full_syntax.c -o $@

ps2/test_avg4_dual_host: ps2/test_avg4_dual_host.c ps2/filter_avg4_dual_mmi.c
	$(CC) $(CFLAGS) ps2/test_avg4_dual_host.c -o $@

ps2/test_wide_paeth_mask_host: ps2/test_wide_host.c ps2/filter_wide_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_PAETH_MASK ps2/test_wide_host.c -o $@

ps2/test_wide_sub6_prefix_host: ps2/test_wide_host.c ps2/filter_wide_mmi.c ps2/filter_sub6_prefix_mmi.c
	$(CC) $(CFLAGS) -DPNG_PS2_EE_MMI_SUB6_PREFIX16 ps2/test_wide_host.c -o $@

ps2/test_paeth_host: ps2/test_paeth_host.c ps2/filter_paeth_mmi.c
	$(CC) $(CFLAGS) ps2/test_paeth_host.c -o $@

ps2/test_mmi_models: ps2/test_mmi_models.c
	$(CC) $(CFLAGS) ps2/test_mmi_models.c -o $@

# Portable-mode syntax checks run with both GCC and Clang on the host.
# This is not a cross-assembly check; it catches C API / feature-flag errors.
.PHONY: syntax syntax-ee-gcc
syntax:
	$(CC) $(CFLAGS) -Wno-unused-function -DPNG_PS2_SYNTAX_PORTABLE -fsyntax-only ps2/test_ee_syntax.c
	$(CC) $(CFLAGS) -Wno-unused-function -DPNG_PS2_SYNTAX_PORTABLE -DPNG_PS2_SYNTAX_DEFAULT -fsyntax-only ps2/test_ee_syntax.c

# GCC parses the inline assembly constraints but still does NOT assemble it.
syntax-ee-gcc:
	gcc $(CFLAGS) -Wno-unused-function -DPNG_PS2_TEST_PALETTE_DISPATCH -fsyntax-only ps2/test_dispatch_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -DPNG_PS2_EE_MMI_UP_4X -DPNG_PS2_EE_MMI_PAETH -fsyntax-only ps2/test_dispatch_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -DPNG_PS2_EE_MMI_UP_4X -DPNG_PS2_EE_MMI_PAETH -DPNG_PS2_EE_MMI_PAETH4_FORCE -fsyntax-only ps2/test_dispatch_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -DPNG_PS2_EE_MMI_UP_2X -fsyntax-only ps2/test_dispatch_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -fsyntax-only ps2/test_dispatch_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -fsyntax-only ps2/test_full_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -fsyntax-only ps2/test_ee_syntax.c
	gcc $(CFLAGS) -Wno-unused-function -DPNG_PS2_SYNTAX_DEFAULT -fsyntax-only ps2/test_ee_syntax.c

test: ps2/test_up_host ps2/test_up_schedules_host ps2/test_up_2x_host ps2/test_gray_host ps2/test_gray_prefix_host ps2/test_rgb3_host ps2/test_rgb3_prefix_host ps2/test_wide_host ps2/test_wide_words_host ps2/test_wide_prefix_host ps2/test_wide_sub6_prefix_host ps2/test_wide_paeth_mask_host ps2/test_paeth_host ps2/test_paeth_mask_host ps2/test_avg4_dual_host ps2/test_extra_host ps2/test_full_syntax_host ps2/test_mmi_models syntax
	./ps2/test_up_host
	./ps2/test_up_schedules_host
	./ps2/test_up_2x_host
	./ps2/test_gray_host
	./ps2/test_gray_prefix_host
	./ps2/test_rgb3_host
	./ps2/test_rgb3_prefix_host
	./ps2/test_wide_host
	./ps2/test_wide_words_host
	./ps2/test_wide_prefix_host
	./ps2/test_paeth_host
	./ps2/test_paeth_mask_host
	./ps2/test_wide_paeth_mask_host
	./ps2/test_wide_sub6_prefix_host
	./ps2/test_avg4_dual_host
	./ps2/test_extra_host
	./ps2/test_palette_hook_host
	./ps2/test_compact_layout_host
	./ps2/test_full_syntax_host
	./ps2/test_mmi_models
	./ps2/test_ab_summary_host
	./ps2/test_fused_host
	$(PYTHON) -m unittest discover -s ps2 -p test_analyze_bench.py
	sh -n ps2/build_filter_variants.sh

clean:
	$(RM) ps2/test_palette_hook_host
	$(RM) ps2/test_compact_layout_host
	$(RM) ps2/test_ab_summary_host
	$(RM) ps2/test_fused_host
	$(RM) ps2/test_wide_host ps2/test_wide_words_host ps2/test_wide_prefix_host ps2/test_wide_sub6_prefix_host ps2/test_wide_paeth_mask_host ps2/test_paeth_mask_host ps2/test_avg4_dual_host ps2/test_extra_host ps2/test_full_syntax_host ps2/test_up_host ps2/test_up_schedules_host ps2/test_up_2x_host ps2/test_gray_host ps2/test_gray_prefix_host ps2/test_rgb3_host ps2/test_rgb3_prefix_host ps2/test_paeth_host ps2/test_mmi_models
